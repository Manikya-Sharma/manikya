---
import SectionHeader from "./SectionHeader.astro";
import StaggerTags from "./StaggerTags.svelte";
import { tagColorMap, bgMap, getTagText } from "@/data/tags";
import StaggerTagsFallback from "./StaggerTagsFallback.astro";

interface Props {
  id: string;
  title?: string;
  images?: {
    title: string;
    items: Array<{ src: ImageMetadata; alt: string }>;
  };
  tags?: Array<keyof typeof bgMap>;
  extlink?: {
    text?: string;
    href: string;
  };
}

const { title, id, images, tags, extlink } = Astro.props;

const bgs = tags?.map((tag) => bgMap[tag]);
const fgs = tags?.map((tag) => tagColorMap[tag]);
const tagNames = tags?.map((tag) => getTagText(tag));
---

<section id={id} class="scroll-m-28">
  {
    title && (
      <SectionHeader title={title} images={images} extlink={extlink} id={id} />
    )
  }
  <div class="mt-8">
    <StaggerTags
      client:only="svelte"
      fgs={fgs}
      bgs={bgs}
      tagNames={tagNames}
      tags={tags}
      server:defer
      loading="lazy"
    >
      <div slot="fallback">
        <StaggerTagsFallback
          fgs={fgs}
          bgs={bgs}
          tags={tags}
          tagNames={tagNames}
          loading="lazy"
        />
      </div>
    </StaggerTags>
  </div>
  <p class="mt-6 sm:mt-10 lg:mt-12 text-pretty mb-28 sm:mb-36 lg:mb-44">
    <slot />
  </p>
</section>
