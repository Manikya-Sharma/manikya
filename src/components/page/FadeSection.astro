---
import SectionHeader from "./SectionHeader.astro";
import StaggerTags from "./StaggerTags.svelte";
import { tagColorMap, bgMap, getTagText } from "@/data/tags";
import StaggerTagsFallback from "./StaggerTagsFallback.astro";

interface Props {
  id: string;
  title?: string;
  images?: {
    title: string;
    items: Array<{ src: ImageMetadata; alt: string }>;
  };
  tags?: Array<keyof typeof bgMap>;
  extlink?: {
    text?: string;
    href: string;
  };
}

const { title, id, images, tags, extlink } = Astro.props;

const bgs = tags?.map((tag) => bgMap[tag]);
const fgs = tags?.map((tag) => tagColorMap[tag]);
const tagNames = tags?.map((tag) => getTagText(tag));
---

<section class="scroll-m-28">
  <SectionHeader title={title} images={images} extlink={extlink} id={id} />
  <StaggerTags
    client:only="svelte"
    fgs={fgs}
    bgs={bgs}
    tagNames={tagNames}
    tags={tags}
    server:defer
  >
    <div slot="fallback">
      <StaggerTagsFallback
        fgs={fgs}
        bgs={bgs}
        tags={tags}
        tagNames={tagNames}
      />
    </div>
  </StaggerTags>
  <p class="mt-8 sm:mt-10 lg:mt-12 text-pretty mb-28 sm:mb-36 lg:mb-52">
    <slot />
  </p>
</section>
