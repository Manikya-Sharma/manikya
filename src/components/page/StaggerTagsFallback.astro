---
interface Props {
  tags: string[] | undefined;
  fgs: string[] | undefined;
  bgs: string[] | undefined;
  tagNames: string[] | undefined;
  loading?: "lazy" | "eager";
}

const { tags, tagNames, bgs, fgs, loading } = Astro.props;
---

<div class="flex gap-2 flex-wrap">
  {
    tags?.map((tag, index) => (
      <span class={`${tags[0]}-tag`}>
        <div
          class:list={[
            "relative inline-block text-sm sm:text-base font-semibold rounded-md",
            bgs?.[index],
          ]}
        >
          <div
            id={`push-div-${tag}`}
            class:list={["rounded-md border px-2 py-1", fgs?.[index]]}
          >
            <span class="flex gap-0.5 items-center">
              <img
                src={`/logos/${tag}-logo.svg`}
                class="block size-5"
                alt={tagNames?.[index]}
                loading={loading}
              />
              <span class="block">{tagNames?.[index]}</span>
            </span>
          </div>
        </div>
      </span>
    ))
  }
</div>
