---
import Breadcrumbs from "./Breadcrumbs.astro";
import ContactsBar from "./ContactsBar.astro";
import ThemeSwitcher from "./ThemeSwitcher.astro";
import Hamburger from "./Hamburger.astro";
import ScrollShorten from "./ScrollShorten.svelte";
const pathname = Astro.url.pathname;

const level = pathname.split("/").length;
---

<ScrollShorten client:load>
  <nav
    class="font-fira px-7 py-5 text-neutral-content flex items-center justify-between"
  >
    <Breadcrumbs pathname={pathname} />
    <div class="flex items-center gap-6 sm:gap-8">
      <ThemeSwitcher class:list={[level >= 3 && "hidden"]} />
      {pathname == "/" ? <ContactsBar /> : <Hamburger pathname={pathname} />}
    </div>
  </nav>
</ScrollShorten>
