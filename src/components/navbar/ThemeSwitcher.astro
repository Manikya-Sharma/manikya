---
import Palette from "@lucide/astro/icons/palette";
import Cat from "@lucide/astro/icons/cat";
import Snowflake from "@lucide/astro/icons/snowflake";
import CakeSlice from "@lucide/astro/icons/cake-slice";
import MountainSnow from "@lucide/astro/icons/mountain-snow";
import Shell from "@lucide/astro/icons/shell";
import Building2 from "@lucide/astro/icons/building";

const themes = [
  {
    label: "Light",
    items: [
      {
        value: "latte",
        label: "Cattpuccin latte",
        icon: Cat,
      },
      {
        value: "lofi",
        label: "Lofi",
        icon: Snowflake,
      },
      {
        value: "cupcake",
        label: "Cupcake",
        icon: CakeSlice,
      },
      {
        value: "nord",
        label: "Nord",
        icon: MountainSnow,
      },
    ],
  },
  {
    label: "Dark",
    items: [
      {
        value: "mocha",
        label: "Cattpuccin mocha",
        icon: Cat,
      },
      {
        value: "kanagawa",
        label: "Kanagawa",
        icon: Shell,
      },
      {
        value: "tokyonight",
        label: "Tokyo Night",
        icon: Building2,
      },
    ],
  },
] as const;

const { class: className } = Astro.props;
---

<div
  class:list={["dropdown dropdown-end", className]}
  id="theme-selector-button"
>
  <div
    class="sm:px-2 tooltip tooltip-bottom tooltip-secondary cursor-pointer font-figtree flex items-center"
    data-tip="Change theme"
    tabindex="0"
    role="button"
  >
    <Palette class="size-4 sm:size-5" />
  </div>
  <ul
    tabindex="-1"
    class="dropdown-content font-figtree bg-neutral menu border border-neutral-content rounded-box z-1 w-52 p-2 shadow-2xl"
  >
    {
      themes.map(({ label, items }) => (
        <li>
          <h2 class="menu-title text-neutral-content">{label}</h2>
          <ul>
            {items.map((theme) => (
              <li>
                <button
                  name="theme-dropdown"
                  class="theme-controller w-full justify-start -ml-4"
                  aria-label={theme.label}
                  id={theme.value}
                >
                  {theme.icon && <theme.icon class="size-4" />} {theme.label}
                </button>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</div>

<!-- script tag suffices here, as we are interfacing with browser and svelte will be overkill -->
<script>
  // set existing theme
  const existingTheme = localStorage.getItem("theme");
  if (existingTheme) {
    document.body.dataset.theme = existingTheme;
  }

  // add event listener when dropdown is opened
  const dropdownButtonElement = document.getElementById(
    "theme-selector-button",
  );

  const themeElementEventSelectorCallback = (val: Event) => {
    const selectedTheme = (val.target as HTMLButtonElement)?.id;
    if (selectedTheme) {
      localStorage.setItem("theme", selectedTheme);
      document.body.dataset.theme = selectedTheme;
    }
  };

  dropdownButtonElement?.addEventListener("click", () => {
    const themeInputElements = document.querySelectorAll(".theme-controller");
    themeInputElements?.forEach((el) =>
      el.removeEventListener("click", themeElementEventSelectorCallback),
    );
    themeInputElements?.forEach((el) =>
      el.addEventListener("click", themeElementEventSelectorCallback),
    );
  });
</script>
