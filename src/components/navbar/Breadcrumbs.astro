---
interface Props {
  pathname: string;
}
const { pathname } = Astro.props;

// filter to avoid empty path when trailing slash
const options = pathname
  .split("/")
  .slice(1)
  .filter((slug) => slug);

const linkClass =
  "inline-block hover:text-accent motion-safe:transition-colors font-semibold";
---

<span class="flex gap-2 tracking-tight text-sm sm:text-base">
  <a class={linkClass} href="/">~</a>
  /
  <a class={linkClass} href="/">manikya</a>
  {
    options.map((path, idx) => (
      <>
        /
        <a class={linkClass} href={`/${options.slice(0, idx + 1).join("/")}`}>
          {path}
        </a>
      </>
    ))
  }
</span>
