---
import "@/globals.css";
import Analytics from "@/components/extras/vercel/Analytics.astro";
import Navbar from "@/components/navbar/Navbar.astro";
import { Font } from "astro:assets";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="This is the portfolio website of Manikya Sharma, an IT Engineer from Delhi Technological University, India"
    />
    <title>Manikya Sharma</title>
    <Font cssVariable="--font-fira" />
    <Font cssVariable="--font-electrolize" />
    <Font cssVariable="--font-space" />
    <Font cssVariable="--font-figtree" />
  </head>
  <body class="min-h-screen flex flex-col text-base-content">
    <Analytics />
    <Navbar />
    <div class="grow">
      <slot />
    </div>
  </body>
</html>
