---
import Hammer from "@lucide/astro/icons/hammer";
import Hash from "@lucide/astro/icons/hash";
import NotebookText from "@lucide/astro/icons/notebook-text";
import Swords from "@lucide/astro/icons/swords";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import BaseLayout from "../layouts/BaseLayout.astro";
const options = [
  { icon: NotebookText, text: "About", href: "/about" },
  { icon: Swords, text: "Skills", href: "/skills" },
  { icon: Hammer, text: "Projects", href: "/projects" },
  { icon: Hash, text: "Socials", href: "/contact" },
];
---

<BaseLayout>
  <main
    class="h-screen grid grid-cols-2 grid-rows-2 gap-2 font-electrolize text-xl sm:text-3xl md:text-5xl"
  >
    {
      options.map((option) => (
        <a
          href={option.href}
          class="h-full w-full grid place-items-center bg-white/30 backdrop-blur-md border border-white/40 rounded-md group"
          style={{ boxShadow: "0 4px 30px rgba(0, 0, 0, 0.1)" }}
          data-astro-prefetch="load"
        >
          <div class="flex items-center gap-3 sm:gap-4">
            <option.icon class="size-5 sm:size-8 md:size-10 motion-safe:group-hover:rotate-12 transition-transform" />
            {option.text}
            <ArrowRight class="size-5 sm:size-8 md:size-10 motion-safe:group-hover:translate-x-3 transition-transform" />
          </div>
        </a>
      ))
    }
  </main>
</BaseLayout>
