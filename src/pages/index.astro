---
import Hammer from "@lucide/astro/icons/hammer";
import Hash from "@lucide/astro/icons/hash";
import Swords from "@lucide/astro/icons/swords";
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutMe from "../components/page/AboutMe.astro";

const options = [
  { icon: Swords, text: "Skills", href: "/skills" },
  { icon: Hammer, text: "Projects", href: "/projects" },
  { icon: Hash, text: "Socials", href: "/contact" },
];

const BG_SLIDE =
  "before:content-[''] before:-skew-x-8 before:absolute before:inset-y-0 before:translate-x-full hover:before:translate-x-0 before:left-0 before:-right-2 motion-safe:before:transition-transform before:bg-base-300 before:rounded-box";
---

<BaseLayout>
  <main class="h-screen pt-16 flex">
    <div class="flex-1 py-10 px-10 bg-linear-90 from-primary/20 to-transparent to-40%">
      <AboutMe />
    </div>
    <div class="flex py-10 flex-col overflow-hidden pl-2">
      {options.map((option, idx) => (
        <a
          href={option.href}
          class:list={[
            "block relative group font-electrolize pl-6 pr-16 py-6",
            BG_SLIDE,
          ]}
          data-astro-prefetch="load"
        >
          <div class="relative z-10 flex items-center gap-4 text-4xl">
            <option.icon
              class="size-7 motion-safe:animate-shake"
              style={{ animationDelay: `${2 * (idx + 1)}s` }}
            />
            {option.text}
          </div>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
