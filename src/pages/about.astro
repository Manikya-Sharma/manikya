---
import ExternalLink from "@lucide/astro/icons/external-link";
import BaseLayout from "@/layouts/BaseLayout.astro";
import DetailPageLayout from "@/layouts/DetailPageLayout.astro";
import StyleLink from "@/components/page/StyleLink.svelte";
import FadeSection from "@/components/page/FadeSection.astro";
import ScrollDownIndicator from "@/components/page/ScrollDownIndicator.svelte";
import BottomNav from "@/components/navbar/BottomNav.astro";

import DtuImage from "@/images/dtu.jpeg";
import RSHallImage from "@/images/hall.jpg";
import PeacockImage from "@/images/peacock.jpg";
import DucksImage from "@/images/ducks.jpg";
---

<BaseLayout>
  <DetailPageLayout>
    <section>
      <div class="uppercase h-screen w-full grid place-items-center">
        <h1 class="text-6xl sm:text-9xl font-space font-semibold tracking-tighter">
          About Me
        </h1>
        <div class="absolute bottom-7 right-5">
          <ScrollDownIndicator client:load />
        </div>
      </div>
    </section>

    <FadeSection id="intro">
      I am a software developer, currently working as a{" "}
      <span class="text-gradient">Platform Engineer</span> at{" "}
      <StyleLink client:load href="https://www.unifyapps.com/">
        UnifyApps
      </StyleLink>
      .
    </FadeSection>
    <FadeSection
      id="education"
      title="Education"
      images={{
        title: "My institution",
        items: [
          { src: DtuImage, alt: "DTU" },
          { src: RSHallImage, alt: "Raj Soin Hall" },
        ],
      }}
    >
      I have completed my bachelor's degree in{" "}
      <span class="text-gradient">Information Technology</span> from{" "}
      <StyleLink client:load href="https://dtu.ac.in">
        <span class="inline-block">
          Delhi Technological University
          <ExternalLink class="inline-block ml-1.5 text-base-content size-4" />
        </span>
      </StyleLink>
      . I have also completed various online courses in artificial intelligence,
      web development and software engineering.
    </FadeSection>
    <FadeSection
      id="interests"
      title="interests"
      images={{
        title: "Travelling",
        items: [
          { src: PeacockImage, alt: "Peacock" },
          { src: DucksImage, alt: "Ducks" },
        ],
      }}
    >
      In my free time, I <span class="text-gradient">enjoy reading</span>, and
      learning about new technologies and{" "}
      <span class="text-gradient">programming languages</span>. I also enjoy
      traveling and exploring new places. I am always looking for new
      opportunities to learn and grow as a developer.
    </FadeSection>
  </DetailPageLayout>
  <BottomNav
    prev={{ href: "/contact", name: "Socials" }}
    next={{ href: "/skills", name: "Skills" }}
  />
</BaseLayout>
